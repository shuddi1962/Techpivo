# TechPivo — Environment Variables for New Vercel + Supabase + Vercel Blob
#
# Copy to .env.local for local development, or set in each Vercel project's
# Environment Variables dashboard. NEVER commit real values to GitHub.

# ============================================================================
# 1. Supabase (shared backend — same project for all 3 Vercel projects)
# ============================================================================
# Create a NEW Supabase project, apply all supabase/migrations/*.sql, then set:
NEXT_PUBLIC_SUPABASE_URL=https://<new-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<new-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<new-service-role-key>

# ============================================================================
# 2. Site configuration
# ============================================================================
NEXT_PUBLIC_SITE_URL=https://techpivo.com
NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-3867128949973557
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-P4B8RS1R1Q
NEXT_PUBLIC_GOOGLE_VERIFICATION=9Y74H2fEVBL_AAWdNoFXcj3Dbh_yzJzC59jnY8d9jas
INDEXNOW_KEY=724630e4ca2b40738c9ab6003372fbf4
REVALIDATION_SECRET=<random-secret>

# ============================================================================
# 3. Email (Resend)
# ============================================================================
RESEND_API_KEY=<resend-api-key>

# ============================================================================
# 4. AI providers
# ============================================================================
GEMINI_API_KEY=<gemini-api-key>
OPENROUTER_API_KEY=<openrouter-api-key>
JINA_API_KEY=<jina-api-key>
DATAFORSEO_LOGIN=<dataforseo-login>
DATAFORSEO_PASSWORD=<dataforseo-password>
PAGESPEED_API_KEY=<pagespeed-api-key>

# ============================================================================
# 5. Payments
# ============================================================================
FLUTTERWAVE_SECRET_KEY=<flutterwave-secret-key>
NEXT_PUBLIC_FLUTTERWAVE_PUBLIC_KEY=<flutterwave-public-key>
FLUTTERWAVE_ENCRYPTION_KEY=<flutterwave-encryption-key>
KORAPAY_SECRET_KEY=<korapay-secret-key>
NEXT_PUBLIC_KORAPAY_PUBLIC_KEY=<korapay-public-key>
KORAPAY_ENCRYPTION_KEY=<korapay-encryption-key>
CJ_API_KEY=<cj-dropshipping-api-key>

# ============================================================================
# 6. Auth / Security
# ============================================================================
NEXT_PUBLIC_TURNSTILE_SITE_KEY=<turnstile-site-key>
TURNSTILE_SECRET_KEY=<turnstile-secret-key>
HIBP_API_KEY=<hibp-api-key>
NEXT_PUBLIC_VAPID_PUBLIC_KEY=<vapid-public-key>
VAPID_PRIVATE_KEY=<vapid-private-key>
CRON_SECRET=<cron-secret>

# ============================================================================
# 7. Vercel Blob (replaces Cloudflare R2)
# ============================================================================
# Create a Vercel Blob store, enable custom domain images.techpivo.com, then set:
BLOB_READ_WRITE_TOKEN=<vercel-blob-token>

# ============================================================================
# 8. Affiliate / Other
# ============================================================================
NORDVPN_AFFILIATE_ID=<nordvp-affiliate-id>
HOSTINGER_AFFILIATE_ID=<hostinger-affiliate-id>
NAMECHEAP_AFFILIATE_ID=<namecheap-affiliate-id>
AMAZON_ASSOCIATE_TAG=techpivo-20
GOOGLE_SERVICE_ACCOUNT_EMAIL=<google-service-account-email>
GOOGLE_PRIVATE_KEY=<google-private-key>
